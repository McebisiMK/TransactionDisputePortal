{
  "DataSeedingOptions": {
    "Enabled": true
  },
  "Keycloak": {
    "RequireHttpsMetadata": false
  },
  "Swagger": {
    "Enabled": true
  },
  "Hosting": {
    "UseHttpsRedirection": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
